{:paths ["src/main/clojure" "src/main/resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        metosin/malli {:mvn/version "0.20.1"}
        metosin/jsonista {:mvn/version "1.0.1"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        ch.qos.logback/logback-classic {:mvn/version "1.6.3"}}

 :aliases {:develop {:extra-paths ["src/develop/clojure" "src/develop/resources"]
                     :extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                                  cider/cider-nrepl {:mvn/version "0.62.2"}}
                     :jvm-opts ["-XX:-OmitStackTraceInFastThrow"]}

           :test {:extra-paths ["src/test/clojure" "src/test/resources"]
                  :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                               lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}
                               lambdaisland/kaocha-junit-xml {:mvn/version "1.17.101"}
                               babashka/process {:mvn/version "0.6.25"}}}

           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                          slipset/deps-deploy {:mvn/version "0.2.5"}}
                   :ns-default build}

           :nop {:extra-deps {org.slf4j/slf4j-nop {:mvn/version "2.0.19"}}}
           :outdated {:extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}}}}
