#kaocha/v1
 {:kaocha/fail-fast? false
  :kaocha/color? true
  :kaocha/reporter [kaocha.report/documentation]
  :kaocha.plugin.randomize/randomize? true
  :capture-output? true

  :plugins [:kaocha.plugin.alpha/info
            :kaocha.plugin/capture-output
            :kaocha.plugin/cloverage
            :kaocha.plugin/filter
            :kaocha.plugin/hooks
            :kaocha.plugin/junit-xml
            :kaocha.plugin/print-invocations
            :kaocha.plugin/randomize]

  :kaocha.hooks/pre-load []
  :kaocha.hooks/post-load []
  :kaocha.hooks/pre-run []
  :kaocha.hooks/post-run []

  :tests [{:id :unit
           :source-paths ["src/main/clojure"]
           :test-paths ["src/test/clojure"]}]

  ;; subset runs stay available: `mise run test --focus <name>` or
  ;; `--focus-meta <meta>`; deftests are intentionally untagged so every
  ;; run executes the whole suite (incl. the ^:integration cycle test)

  :cloverage/opts {:output "target/coverage"
                   :ns-regex []
                   :ns-exclude-regex []
                   ;; `locking` expands to monitor-enter/monitor-exit, which
                   ;; cloverage 1.2.4 cannot instrument (WARNs "Unknown
                   ;; special form") — exclude its call sites
                   :exclude-call [clojure.core/locking]
                   :fail-threshold 0
                   :low-watermark 50
                   :high-watermark 80
                   :summary? true
                   :html? true
                   :codecov? true}

  :kaocha.plugin.junit-xml/target-file "target/coverage/junit.xml"
  :kaocha.plugin.junit-xml/omit-system-out? true}
